<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GtPlus.Controls"
             x:Class="GtPlus.Controls.PropertiesPanelControl">

    <!--
        The ribbon. Laid out like vMix GT Title Designer's: a File tab, then
        Home / Styles / Format / Effects / Animations / Data (+ View, GT Plus only),
        each tab a row of captioned groups.

        Every group is the same shape: up to three 22px control rows (4px apart)
        centred over a caption. Groups the selection cannot use grey out rather
        than disappear, so a tab never reflows under the pointer.

        Window-level commands (undo, clipboard, layers, timeline, guides) belong to
        MainWindow, which drops them into the *Content slots below.
    -->

    <UserControl.Styles>

        <!-- compact NumericUpDown: text on left, tiny ▲▼ on right -->
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="*,14">
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4,0"
                                     MinHeight="0"
                                     MinWidth="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Right"/>
                            <ButtonSpinner x:Name="PART_Spinner"
                                           Grid.Column="1"
                                           IsTabStop="False"
                                           Focusable="False"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           MinWidth="0"
                                           MinHeight="0"
                                           AllowSpin="{TemplateBinding AllowSpin}"
                                           ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
        </Style>
        <Style Selector="NumericUpDown:focus-within">
            <Setter Property="BorderBrush" Value="#1e5b9b"/>
        </Style>

        <!-- ButtonSpinner: two tiny stacked arrow buttons -->
        <Style Selector="ButtonSpinner">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- the spinner and its arrows are mouse-only: Tab has to walk box to box, not stop on them -->
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="*,*" Width="14">
                        <RepeatButton x:Name="PART_IncreaseButton"
                                      Grid.Row="0"
                                      IsTabStop="False" Focusable="False"
                                      MinWidth="0" MinHeight="0" Padding="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <Path Data="M 0,3 L 3,0 L 6,3" Stroke="#8a8a8a" StrokeThickness="1"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </RepeatButton>
                        <RepeatButton x:Name="PART_DecreaseButton"
                                      Grid.Row="1"
                                      IsTabStop="False" Focusable="False"
                                      MinWidth="0" MinHeight="0" Padding="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <Path Data="M 0,0 L 3,3 L 6,0" Stroke="#8a8a8a" StrokeThickness="1"
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ButtonSpinner RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2e2e2e"/>
        </Style>

        <!-- every input in the ribbon is one 22px row -->
        <Style Selector="Border.group ComboBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.group TextBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.group AutoCompleteBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Border.group AutoCompleteBox /template/ TextBox#PART_TextBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.group Slider">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- compact three-state checkboxes -->
        <Style Selector="Border.group CheckBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="14,*" Background="Transparent">
                        <Border x:Name="CheckBorder"
                                Grid.Column="0"
                                Width="14" Height="14"
                                Background="#222222"
                                BorderBrush="#4a4a4a"
                                BorderThickness="1"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <Panel>
                                <Path x:Name="TickGlyph"
                                      IsVisible="False"
                                      Stretch="None"
                                      Stroke="#ffffff"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,3 L 2.6,5.6 L 7,1"/>
                                <!-- indeterminate: a dash, meaning the selection disagrees -->
                                <Border x:Name="DashGlyph"
                                        IsVisible="False"
                                        Width="6" Height="2"
                                        Background="#e6e6e6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Panel>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Margin="8,0,0,0"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Border.group CheckBox:checked /template/ Path#TickGlyph">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.group CheckBox:checked /template/ Border#CheckBorder">
            <Setter Property="Background" Value="#1e5b9b"/>
            <Setter Property="BorderBrush" Value="#1e5b9b"/>
        </Style>
        <Style Selector="Border.group CheckBox:indeterminate /template/ Border#DashGlyph">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.group CheckBox:pointerover /template/ Border#CheckBorder">
            <Setter Property="BorderBrush" Value="#7a7a7a"/>
        </Style>

        <!-- colour swatch buttons: Fill, Stroke, Shadow -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="BorderBrush" Value="#5a5a5a"/>
        </Style>

        <!-- small icon toggles for text style / alignment -->
        <Style Selector="ToggleButton.rb.sm Image">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="ToggleButton.rb.sm TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <DockPanel x:Name="PropertiesBar" Background="#141414">

        <!-- ── tab strip ── -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="28">

            <ContentControl x:Name="FileHost" Grid.Column="0" VerticalAlignment="Stretch"/>

            <StackPanel x:Name="TabStrip" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <ToggleButton Classes="tab" Content="Home"       Tag="Home"       IsChecked="True"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
                <ToggleButton Classes="tab" Content="Styles"     Tag="Styles"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
                <ToggleButton Classes="tab" Content="Format"     Tag="Format"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
                <ToggleButton Classes="tab" Content="Effects"    Tag="Effects"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
                <ToggleButton Classes="tab" Content="Animations" Tag="Animations"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
                <ToggleButton Classes="tab" Content="Data"       Tag="Data"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
                <ToggleButton Classes="tab" Content="View"       Tag="View"
                              ToolTip.Tip="Rulers, guides, snapping and preferences"
                              Click="RibbonTab_Click" DoubleTapped="RibbonTab_DoubleTapped"/>
            </StackPanel>

            <ContentControl x:Name="QuickAccessHost" Grid.Column="3" VerticalAlignment="Center"/>

            <Button x:Name="RibbonCollapseButton" Grid.Column="4"
                    Classes="rb sm" Margin="2,0,6,0"
                    ToolTip.Tip="Collapse the ribbon (double-click a tab does the same)"
                    Click="RibbonCollapse_Click">
                <Path x:Name="RibbonCollapseGlyph" Classes="ic s12"
                      Data="M 6,15 L 12,9 L 18,15"/>
            </Button>
        </Grid>

        <!-- ── ribbon body ── -->
        <Border x:Name="RibbonBody"
                Background="#1b1b1b"
                BorderBrush="#2e2e2e"
                BorderThickness="0,1,0,1"
                Margin="0,-1,0,0"
                Height="102">
            <Panel>

                <!-- ════════ HOME ════════ -->
                <ScrollViewer x:Name="HomePage" Classes="page"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,0">

                        <ContentControl x:Name="HomeStartHost"/>

                        <!-- text-specific (GtTextBlock only): Font, Text, Content -->
                        <StackPanel x:Name="TextSpecificPanel" Orientation="Horizontal" IsEnabled="False">

                            <Border Classes="group" x:Name="FontGroup">
                                <DockPanel>
                                    <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Font"/>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <AutoCompleteBox x:Name="FontFamilyBox" Width="164"
                                                             MaxDropDownHeight="300"
                                                             MinimumPrefixLength="0"
                                                             MinimumPopulateDelay="0"
                                                             FilterMode="Contains"
                                                             ToolTip.Tip="Font family"/>
                                            <NumericUpDown x:Name="FontSizeBox" Width="64"
                                                           FormatString="F1" Minimum="1" Maximum="999"
                                                           Increment="1"
                                                           ToolTip.Tip="Font size"
                                                           ValueChanged="FontSizeBox_ValueChanged"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <ComboBox x:Name="FontWeightBox" Width="132"
                                                      ToolTip.Tip="Font weight"
                                                      SelectionChanged="FontWeightBox_SelectionChanged"/>
                                            <ToggleButton x:Name="ItalicButton" Classes="rb sm" Margin="4,0,0,0"
                                                          ToolTip.Tip="Italic" Click="ItalicButton_Click">
                                                <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="FauxItalicButton" Classes="rb sm"
                                                          ToolTip.Tip="Faux italic, as Photoshop does it: slants the text 10° about its baseline. Saved as GT's own Skew effect, so vMix shows the same slant"
                                                          Click="FauxItalicButton_Click">
                                                <TextBlock Text="I" FontWeight="SemiBold" Foreground="#9ccdf5">
                                                    <TextBlock.RenderTransform>
                                                        <SkewTransform AngleX="-10"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </ToggleButton>
                                            <ToggleButton x:Name="UnderlineButton" Classes="rb sm"
                                                          ToolTip.Tip="Underline" Click="UnderlineButton_Click">
                                                <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="StrikeButton" Classes="rb sm"
                                                          ToolTip.Tip="Strikethrough" Click="StrikeButton_Click">
                                                <TextBlock Text="abc" FontSize="10" TextDecorations="Strikethrough"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="UppercaseButton" Classes="rb sm"
                                                          ToolTip.Tip="Auto upper case" Click="UppercaseButton_Click">
                                                <TextBlock Text="Aa" FontSize="11"/>
                                            </ToggleButton>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Classes="group">
                                <DockPanel>
                                    <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Text"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,4,Auto,4,Auto">
                                            <ToggleButton x:Name="HAlignLeftButton" Grid.Row="0" Grid.Column="0" Classes="rb sm"
                                                          ToolTip.Tip="Align left" Click="HAlignLeft_Click">
                                                <Image Source="avares://GtPlus/Assets/Icons/align-left.png"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="HAlignCenterButton" Grid.Row="0" Grid.Column="1" Classes="rb sm"
                                                          ToolTip.Tip="Align centre" Click="HAlignCenter_Click">
                                                <Image Source="avares://GtPlus/Assets/Icons/align-center.png"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="HAlignRightButton" Grid.Row="0" Grid.Column="2" Classes="rb sm"
                                                          ToolTip.Tip="Align right" Click="HAlignRight_Click">
                                                <Image Source="avares://GtPlus/Assets/Icons/align-right.png"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="VAlignTopButton" Grid.Row="2" Grid.Column="0" Classes="rb sm"
                                                          ToolTip.Tip="Align top" Click="VAlignTop_Click">
                                                <Image Source="avares://GtPlus/Assets/Icons/align-top.png"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="VAlignCenterButton" Grid.Row="2" Grid.Column="1" Classes="rb sm"
                                                          ToolTip.Tip="Align middle" Click="VAlignCenter_Click">
                                                <Image Source="avares://GtPlus/Assets/Icons/align-middle.png"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="VAlignBottomButton" Grid.Row="2" Grid.Column="2" Classes="rb sm"
                                                          ToolTip.Tip="Align bottom" Click="VAlignBottom_Click">
                                                <Image Source="avares://GtPlus/Assets/Icons/align-bottom.png"/>
                                            </ToggleButton>
                                            <ToggleButton x:Name="WordWrapButton" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                          Classes="rb row" ToolTip.Tip="Word wrap"
                                                          Click="WordWrapButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Classes="ic s14"
                                                          Data="M 3,6 L 21,6 M 3,12 L 18,12 A 3,3 0 0 1 18,18 L 13,18 M 15,16 L 13,18 L 15,20 M 3,18 L 9,18"/>
                                                    <TextBlock Text="Wrap"/>
                                                </StackPanel>
                                            </ToggleButton>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,4,Auto" VerticalAlignment="Center">
                                            <TextBlock x:Name="SpacingLabel" Grid.Row="0" Grid.Column="0" Classes="lbl"
                                                       Text="Spacing" ToolTip.Tip="Drag to change"/>
                                            <NumericUpDown x:Name="SpacingBox" Grid.Row="0" Grid.Column="1" Width="64"
                                                           FormatString="F0" Minimum="1" Maximum="200" Increment="1"
                                                           ToolTip.Tip="Line spacing %, a multiplier of the font line height. GT caps this at 200%."
                                                           ValueChanged="SpacingBox_ValueChanged"/>
                                            <!-- auto-size: a Ticker forces its own, so this greys out for one -->
                                            <StackPanel x:Name="AutoSizePanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Orientation="Horizontal">
                                                <TextBlock Classes="lbl" Text="Auto size" Width="50"/>
                                                <ComboBox x:Name="AutoSizeBox" Width="110"
                                                          ToolTip.Tip="Configure automatic text box resizing"
                                                          SelectionChanged="AutoSizeBox_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- text content: edits the primary only, so it greys out on a multi-selection -->
                            <Border Classes="group" x:Name="TextInputGroup">
                                <DockPanel>
                                    <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Content"/>
                                    <TextBox x:Name="TextInputBox" Width="180" Height="70"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Padding="6,4"
                                             VerticalContentAlignment="Top"
                                             PlaceholderText="Text"
                                             TextChanged="TextInputBox_TextChanged"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- image source + size mode (GtImageElement only) -->
                        <Border Classes="group" x:Name="ImagePanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Image"/>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="ImageBrowseButton" Classes="rb row"
                                            ToolTip.Tip="Replace this image's source file"
                                            Click="ImageBrowseButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14"
                                                  Data="M 3,7 L 3,19 A 1,1 0 0 0 4,20 L 20,20 A 1,1 0 0 0 21,19 L 21,9 A 1,1 0 0 0 20,8 L 12,8 L 10,5 L 4,5 A 1,1 0 0 0 3,6 Z"/>
                                            <TextBlock Text="Browse…"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="lbl" Text="Size mode"/>
                                        <ComboBox x:Name="ImageSizeModeBox" Width="104"
                                                  SelectionChanged="ImageSizeModeBox_SelectionChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- web page reference (GtWebElement only) - GT Plus -->
                        <Border Classes="group" x:Name="WebPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Web page"/>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBox x:Name="WebUrlBox" Width="200" Height="22"
                                                 Padding="6,0" VerticalContentAlignment="Center"
                                                 PlaceholderText="https://…"
                                                 ToolTip.Tip="Page to capture. Design-time reference only - a web object is never written to the .gtzip and never appears in a video export"
                                                 KeyDown="WebUrlBox_KeyDown"
                                                 LostFocus="WebUrlBox_LostFocus"/>
                                        <Button x:Name="WebReloadButton" Classes="rb sm"
                                                ToolTip.Tip="Capture the page again now"
                                                Click="WebReloadButton_Click">
                                            <Path Classes="ic s14"
                                                  Data="M 21,12 A 9,9 0 1 1 18.4,5.6 M 21,3 L 21,9 L 15,9"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox x:Name="WebInteractiveCheck"
                                                  Content="Interactive"
                                                  ToolTip.Tip="Click, scroll and type into the page. While this is on the box cannot be selected or dragged by clicking it - hold Alt for that, or press Escape to give the keyboard back"
                                                  IsCheckedChanged="WebInteractiveCheck_Changed"/>
                                        <CheckBox x:Name="WebTransparentCheck"
                                                  Content="Transparent"
                                                  ToolTip.Tip="Render over a transparent page background instead of white"
                                                  IsCheckedChanged="WebTransparentCheck_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- align: one element aligns to the canvas, several to their own bounds -->
                        <Border Classes="group" x:Name="AlignGroup" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Align"/>
                                <Grid ColumnDefinitions="Auto,Auto,Auto,8,Auto" RowDefinitions="Auto,4,Auto"
                                      VerticalAlignment="Center">
                                    <Button Grid.Row="0" Grid.Column="0" x:Name="AlignLeftButton" Classes="rb sm"
                                            ToolTip.Tip="Align left edges  (Shift: align to canvas)"
                                            Click="AlignLeftButton_Click">
                                        <Path Fill="#e6e6e6" Stretch="None"
                                              Data="M 0,0 L 1.5,0 L 1.5,14 L 0,14 Z M 3,2 L 13,2 L 13,6 L 3,6 Z M 3,8 L 9,8 L 9,12 L 3,12 Z"/>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1" x:Name="AlignCenterHButton" Classes="rb sm"
                                            ToolTip.Tip="Align horizontal centres  (Shift: align to canvas)"
                                            Click="AlignCenterHButton_Click">
                                        <Path Fill="#e6e6e6" Stretch="None"
                                              Data="M 6.25,0 L 7.75,0 L 7.75,14 L 6.25,14 Z M 2,2 L 12,2 L 12,6 L 2,6 Z M 4,8 L 10,8 L 10,12 L 4,12 Z"/>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="2" x:Name="AlignRightButton" Classes="rb sm"
                                            ToolTip.Tip="Align right edges  (Shift: align to canvas)"
                                            Click="AlignRightButton_Click">
                                        <Path Fill="#e6e6e6" Stretch="None"
                                              Data="M 12.5,0 L 14,0 L 14,14 L 12.5,14 Z M 1,2 L 11,2 L 11,6 L 1,6 Z M 5,8 L 11,8 L 11,12 L 5,12 Z"/>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="0" x:Name="AlignTopButton" Classes="rb sm"
                                            ToolTip.Tip="Align top edges  (Shift: align to canvas)"
                                            Click="AlignTopButton_Click">
                                        <Path Fill="#e6e6e6" Stretch="None"
                                              Data="M 0,0 L 14,0 L 14,1.5 L 0,1.5 Z M 2,3 L 6,3 L 6,13 L 2,13 Z M 8,3 L 12,3 L 12,9 L 8,9 Z"/>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="1" x:Name="AlignMiddleButton" Classes="rb sm"
                                            ToolTip.Tip="Align vertical centres  (Shift: align to canvas)"
                                            Click="AlignMiddleButton_Click">
                                        <Path Fill="#e6e6e6" Stretch="None"
                                              Data="M 0,6.25 L 14,6.25 L 14,7.75 L 0,7.75 Z M 2,2 L 6,2 L 6,12 L 2,12 Z M 8,4 L 12,4 L 12,10 L 8,10 Z"/>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="2" x:Name="AlignBottomButton" Classes="rb sm"
                                            ToolTip.Tip="Align bottom edges  (Shift: align to canvas)"
                                            Click="AlignBottomButton_Click">
                                        <Path Fill="#e6e6e6" Stretch="None"
                                              Data="M 0,12.5 L 14,12.5 L 14,14 L 0,14 Z M 2,1 L 6,1 L 6,11 L 2,11 Z M 8,5 L 12,5 L 12,11 L 8,11 Z"/>
                                    </Button>
                                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
                                            x:Name="AlignCenterBothButton" Classes="rb" Width="24" Height="48" Padding="0"
                                            ToolTip.Tip="Centre horizontally and vertically  (Shift: centre on canvas)"
                                            Click="AlignCenterBothButton_Click">
                                        <Panel Width="14" Height="14">
                                            <Path Fill="#e6e6e6" Stretch="None"
                                                  Data="M 6.25,0 L 7.75,0 L 7.75,14 L 6.25,14 Z M 0,6.25 L 14,6.25 L 14,7.75 L 0,7.75 Z"/>
                                            <Path Fill="#e6e6e6" Stretch="None"
                                                  Data="M 4,4 L 10,4 L 10,10 L 4,10 Z"/>
                                        </Panel>
                                    </Button>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <ContentControl x:Name="HomeEndHost"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════ STYLES ════════ -->
                <ScrollViewer x:Name="StylesPage" IsVisible="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FillStrokePanel" Orientation="Horizontal" Margin="4,0" IsEnabled="False">

                        <Border Classes="group">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Fill"/>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="FillColorButton" Classes="swatch"
                                            ToolTip.Tip="Fill colour, gradient or picture"
                                            Click="FillColorButton_Click">
                                        <Panel>
                                            <Border CornerRadius="3" Background="#6a6a6a"/>
                                            <Border x:Name="FillColorSwatch" CornerRadius="3"/>
                                        </Panel>
                                    </Button>
                                    <TextBlock Classes="lbl" Text="Colour" HorizontalAlignment="Center" Margin="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Classes="group">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Stroke"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <Button x:Name="StrokeColorButton" Classes="swatch"
                                                ToolTip.Tip="Stroke colour"
                                                Click="StrokeColorButton_Click">
                                            <Panel>
                                                <Border CornerRadius="3" Background="#6a6a6a"/>
                                                <Border x:Name="StrokeColorSwatch" CornerRadius="3"/>
                                            </Panel>
                                        </Button>
                                        <TextBlock Classes="lbl" Text="Colour" HorizontalAlignment="Center" Margin="0"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,104" RowDefinitions="Auto,4,Auto,4,Auto"
                                          VerticalAlignment="Center">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="Thickness"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="StrokeThicknessBox"
                                                       FormatString="F1" Minimum="0" Maximum="99" Increment="1"
                                                       ValueChanged="StrokeThicknessBox_ValueChanged"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="Style"
                                                   x:Name="StrokeStyleLabel"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="StrokeStyleBox"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="StrokeStyleBox_SelectionChanged"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="lbl" Text="Corners"
                                                   x:Name="CornersLabel"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CornersBox"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="CornersBox_SelectionChanged"/>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════ FORMAT ════════ -->
                <ScrollViewer x:Name="FormatPage" IsVisible="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,0">

                        <!-- location / rotation / dimensions never leave the ribbon, they grey out instead -->
                        <StackPanel x:Name="PositionSizePanel" Orientation="Horizontal" IsEnabled="False">

                            <Border Classes="group">
                                <DockPanel>
                                    <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Location"/>
                                    <Grid ColumnDefinitions="16,76" RowDefinitions="Auto,4,Auto,4,Auto" VerticalAlignment="Center">
                                        <TextBlock x:Name="XLabel" Grid.Row="0" Classes="lbl" Text="X"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="XBox"
                                                       FormatString="F1" Minimum="-9999" Maximum="9999" Increment="1"
                                                       ValueChanged="XBox_ValueChanged"/>
                                        <TextBlock x:Name="YLabel" Grid.Row="2" Classes="lbl" Text="Y"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="YBox"
                                                       FormatString="F1" Minimum="-9999" Maximum="9999" Increment="1"
                                                       ValueChanged="YBox_ValueChanged"/>
                                        <TextBlock x:Name="ZLabel" Grid.Row="4" Classes="lbl" Text="Z"/>
                                        <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="ZBox"
                                                       FormatString="F1" Minimum="-9999" Maximum="9999" Increment="1"
                                                       ValueChanged="ZBox_ValueChanged"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Classes="group">
                                <DockPanel>
                                    <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Rotate"/>
                                    <Grid ColumnDefinitions="16,76" RowDefinitions="Auto,4,Auto,4,Auto" VerticalAlignment="Center">
                                        <TextBlock x:Name="RxLabel" Grid.Row="0" Classes="lbl" Text="X"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="RxBox"
                                                       FormatString="F1" Minimum="-360" Maximum="360" Increment="1"
                                                       ToolTip.Tip="Degrees"
                                                       ValueChanged="RxBox_ValueChanged"/>
                                        <TextBlock x:Name="RyLabel" Grid.Row="2" Classes="lbl" Text="Y"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="RyBox"
                                                       FormatString="F1" Minimum="-360" Maximum="360" Increment="1"
                                                       ToolTip.Tip="Degrees"
                                                       ValueChanged="RyBox_ValueChanged"/>
                                        <TextBlock x:Name="RzLabel" Grid.Row="4" Classes="lbl" Text="Z"/>
                                        <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="RzBox"
                                                       FormatString="F1" Minimum="-360" Maximum="360" Increment="1"
                                                       ToolTip.Tip="Degrees"
                                                       ValueChanged="RzBox_ValueChanged"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Classes="group">
                                <DockPanel>
                                    <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Dimensions"/>
                                    <Grid ColumnDefinitions="Auto,76" RowDefinitions="Auto,4,Auto,4,Auto" VerticalAlignment="Center">
                                        <TextBlock x:Name="WLabel" Grid.Row="0" Classes="lbl" Text="Width"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="WBox"
                                                       FormatString="F1" Minimum="1" Maximum="9999" Increment="1"
                                                       ValueChanged="WBox_ValueChanged"/>
                                        <TextBlock x:Name="HLabel" Grid.Row="2" Classes="lbl" Text="Height"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="HBox"
                                                       FormatString="F1" Minimum="1" Maximum="9999" Increment="1"
                                                       ValueChanged="HBox_ValueChanged"/>
                                        <TextBlock x:Name="DLabel" Grid.Row="4" Classes="lbl" Text="Depth"/>
                                        <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="DBox"
                                                       FormatString="F1" Minimum="-9999" Maximum="9999" Increment="1"
                                                       ValueChanged="DBox_ValueChanged"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ticker scroll properties (GtTickerElement only) -->
                        <Border Classes="group" x:Name="TickerPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Ticker"/>
                                <Grid ColumnDefinitions="Auto,104" RowDefinitions="Auto,4,Auto,4,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Row="0" Classes="lbl" Text="Type"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TickerTypeBox"
                                              HorizontalAlignment="Stretch"
                                              ToolTip.Tip="Replace loops the text forever; Add plays each update once"
                                              SelectionChanged="TickerTypeBox_SelectionChanged"/>
                                    <TextBlock Grid.Row="2" Classes="lbl" Text="Direction"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TickerDirectionBox"
                                              HorizontalAlignment="Stretch"
                                              ToolTip.Tip="Direction the content travels in"
                                              SelectionChanged="TickerDirectionBox_SelectionChanged"/>
                                    <TextBlock Grid.Row="4" Classes="lbl" Text="Speed" x:Name="TickerSpeedLabel"
                                               ToolTip.Tip="Drag to change; hold Alt for 0.1 steps"/>
                                    <!-- ticker preview transport: scrolls the tickers in place while the timeline is idle -->
                                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                                        <NumericUpDown Grid.Column="0" x:Name="TickerSpeedBox"
                                                       FormatString="F2" Minimum="0" Maximum="999" Increment="0.5"
                                                       ToolTip.Tip="Pixels per frame - the composition's frame rate sets the on-screen speed"
                                                       ValueChanged="TickerSpeedBox_ValueChanged"/>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Classes="group" x:Name="TickerTransportGroup">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Ticker preview"/>
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                    <Button x:Name="TickerPlayButton" Classes="rb lg"
                                            ToolTip.Tip="Play / pause the ticker scroll"
                                            Click="TickerPlayButton_Click">
                                        <StackPanel>
                                            <Panel Width="24" Height="24" Margin="0,4,0,6" HorizontalAlignment="Center">
                                                <Path x:Name="TickerPlayGlyph" Classes="ic s24"
                                                      Data="M 7,4 L 19,12 L 7,20 Z"/>
                                                <Path x:Name="TickerPauseGlyph" Classes="ic s24"
                                                      IsVisible="False"
                                                      Data="M 7,4 L 10,4 L 10,20 L 7,20 Z M 14,4 L 17,4 L 17,20 L 14,20 Z"/>
                                            </Panel>
                                            <TextBlock Text="Play"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TickerStopButton" Classes="rb lg"
                                            ToolTip.Tip="Stop and rewind the ticker scroll"
                                            Click="TickerStopButton_Click">
                                        <StackPanel>
                                            <Path Classes="ic" Data="M 6,6 L 18,6 L 18,18 L 6,18 Z"/>
                                            <TextBlock Text="Stop"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- bounding: takes x, y, width and height from a sibling, grown by the padding -->
                        <Border Classes="group" x:Name="BoundingPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Bounding"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Classes="lbl" Text="Object"/>
                                        <ComboBox x:Name="BoundingObjectBox" Width="132"
                                                  ToolTip.Tip="Follow another element in the same layer: this element takes that element's position and size, grown by the padding. Its own position and size become read-only."
                                                  SelectionChanged="BoundingObjectBox_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="BoundingPaddingPanel" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="48,52,12,48,52" RowDefinitions="Auto,4,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="PadLeftLabel" Classes="lbl" Text="Left"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="PadLeftBox"
                                                           FormatString="F0" Minimum="-9999" Maximum="9999" Increment="1"
                                                           ToolTip.Tip="Padding on the left edge - drag the label to scrub"
                                                           ValueChanged="PaddingBox_ValueChanged"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="PadTopLabel" Classes="lbl" Text="Top"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="4" x:Name="PadTopBox"
                                                           FormatString="F0" Minimum="-9999" Maximum="9999" Increment="1"
                                                           ToolTip.Tip="Padding on the top edge - drag the label to scrub"
                                                           ValueChanged="PaddingBox_ValueChanged"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PadRightLabel" Classes="lbl" Text="Right"/>
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="PadRightBox"
                                                           FormatString="F0" Minimum="-9999" Maximum="9999" Increment="1"
                                                           ToolTip.Tip="Padding on the right edge - drag the label to scrub"
                                                           ValueChanged="PaddingBox_ValueChanged"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="PadBottomLabel" Classes="lbl" Text="Bottom"/>
                                            <NumericUpDown Grid.Row="2" Grid.Column="4" x:Name="PadBottomBox"
                                                           FormatString="F0" Minimum="-9999" Maximum="9999" Increment="1"
                                                           ToolTip.Tip="Padding on the bottom edge - drag the label to scrub"
                                                           ValueChanged="PaddingBox_ValueChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- anchor: which point of the box X/Y measure from -->
                        <Border Classes="group" x:Name="AnchorGroup" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Anchor"/>
                                <ComboBox x:Name="AnchorBox" Width="120" VerticalAlignment="Center"
                                          ToolTip.Tip="Which point of the box X/Y measure from - GT's own Anchor property, stored in the file. Switching it does not move the element: the X/Y readout changes to the new point, and W/H then grow away from it."
                                          SelectionChanged="AnchorBox_SelectionChanged"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════ EFFECTS ════════ -->
                <ScrollViewer x:Name="EffectsPage" IsVisible="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,0">

                        <!-- opacity: model stores 0-1, the ribbon shows whole percent -->
                        <Border Classes="group" x:Name="OpacityPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Opacity"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Slider x:Name="OpacitySlider" Width="96"
                                            Minimum="0" Maximum="100"
                                            ToolTip.Tip="Element opacity (0-1 in the file)"/>
                                    <NumericUpDown x:Name="OpacityBox" Width="56"
                                                   FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                    <TextBlock Classes="lbl" Text="%" Margin="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- shadow: GT's preset gallery, a colour and the two numbers behind the presets -->
                        <Border Classes="group" x:Name="ShadowPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Shadow"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <Button x:Name="ShadowColorButton" Classes="swatch"
                                                ToolTip.Tip="Shadow colour - only editable once the element has a shadow, exactly as GT's gallery menu behaves"
                                                Click="ShadowColorButton_Click">
                                            <Panel>
                                                <Border CornerRadius="3" Background="#6a6a6a"/>
                                                <Border x:Name="ShadowColorSwatch" CornerRadius="3"/>
                                            </Panel>
                                        </Button>
                                        <TextBlock Classes="lbl" Text="Colour" HorizontalAlignment="Center" Margin="0"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,148" RowDefinitions="Auto,4,Auto,4,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Row="0" Classes="lbl" Text="Preset"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ShadowPresetBox"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="GT's twelve shadow presets. None removes the effect entirely - GT has no disabled-but-present shadow."
                                                  SelectionChanged="ShadowPresetBox_SelectionChanged"/>
                                        <TextBlock Grid.Row="2" Classes="lbl" Text="Blur" x:Name="ShadowBlurLabel"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="ShadowBlurBox"
                                                       FormatString="0.##" Minimum="0" Maximum="200" Increment="1"
                                                       ToolTip.Tip="Gaussian standard deviation in composition pixels; the shadow fades out at about three times this. GT's presets are 0, 3, 5 and 9."
                                                       ValueChanged="ShadowBlurBox_ValueChanged"/>
                                        <TextBlock Grid.Row="4" Classes="lbl" Text="Offset" x:Name="ShadowOffsetLabel"/>
                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,4,*">
                                            <NumericUpDown Grid.Column="0" x:Name="ShadowOffsetXBox"
                                                           FormatString="0.##" Minimum="-999" Maximum="999" Increment="1"
                                                           ToolTip.Tip="Shadow X offset in composition pixels, positive is right"
                                                           ValueChanged="ShadowOffsetBox_ValueChanged"/>
                                            <NumericUpDown Grid.Column="2" x:Name="ShadowOffsetYBox"
                                                           FormatString="0.##" Minimum="-999" Maximum="999" Increment="1"
                                                           ToolTip.Tip="Shadow Y offset in composition pixels, positive is down"
                                                           ValueChanged="ShadowOffsetBox_ValueChanged"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- reflection: GT's Finish-stage mirror under the object; Depth is the share of its height the fade reaches -->
                        <Border Classes="group" x:Name="ReflectionPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Reflection"/>
                                <Grid ColumnDefinitions="Auto,4,Auto,4,Auto" RowDefinitions="Auto,4,Auto" VerticalAlignment="Center">
                                    <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" x:Name="ReflectionPresetBox"
                                              Width="148" HorizontalAlignment="Left"
                                              ToolTip.Tip="Mirror the object under its bottom edge, fading out"
                                              SelectionChanged="ReflectionPresetBox_SelectionChanged"/>
                                    <Slider Grid.Row="2" Grid.Column="0" x:Name="ReflectionDepthSlider" Width="64"
                                            Minimum="0" Maximum="100"
                                            ToolTip.Tip="Depth - how much of the object's height the reflection reaches"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="2" x:Name="ReflectionDepthBox" Width="56"
                                                   FormatString="F0" Minimum="0" Maximum="100" Increment="5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Classes="lbl" Text="%" Margin="0"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- skew: GT's Skew effect, X and Y shear in degrees; back to 0,0 removes the effect -->
                        <Border Classes="group" x:Name="SkewPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Skew"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="16,96,4,56" RowDefinitions="Auto,4,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="X" Margin="0"/>
                                        <Slider Grid.Row="0" Grid.Column="1" x:Name="SkewXSlider" Minimum="-60" Maximum="60"
                                                ToolTip.Tip="Horizontal skew in degrees - positive pushes the bottom right"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="3" x:Name="SkewXBox"
                                                       FormatString="F0" Minimum="-85" Maximum="85" Increment="1"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="Y" Margin="0"/>
                                        <Slider Grid.Row="2" Grid.Column="1" x:Name="SkewYSlider" Minimum="-60" Maximum="60"
                                                ToolTip.Tip="Vertical skew in degrees - positive pushes the right side down"/>
                                        <NumericUpDown Grid.Row="2" Grid.Column="3" x:Name="SkewYBox"
                                                       FormatString="F0" Minimum="-85" Maximum="85" Increment="1"/>
                                    </Grid>
                                    <Button x:Name="SkewResetButton" Classes="rb sm" VerticalAlignment="Center"
                                            ToolTip.Tip="Remove the skew" Click="SkewResetButton_Click">
                                        <Border Background="#e6e6e6" Width="14" Height="14">
                                            <Border.OpacityMask>
                                                <ImageBrush Source="avares://GtPlus/Assets/Icons/revert.png" Stretch="Uniform"/>
                                            </Border.OpacityMask>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- texture flip: GT's FlipY ("Vertical") and FlipX ("Horizontal") effects mirror the object's own texture -->
                        <Border Classes="group" x:Name="TextureFlipPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Texture flip"/>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <CheckBox x:Name="FlipVerticalCheck" Content="Vertical"
                                              ToolTip.Tip="Flip the texture top to bottom" Click="FlipCheck_Click"/>
                                    <CheckBox x:Name="FlipHorizontalCheck" Content="Horizontal"
                                              ToolTip.Tip="Flip the texture left to right" Click="FlipCheck_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- mask: vMix resolves a mask by name within the element's own layer -->
                        <Border Classes="group" x:Name="MaskPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Mask"/>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="lbl" Text="Object"/>
                                    <ComboBox x:Name="MaskObjectBox" Width="140"
                                              ToolTip.Tip="Clip this element to another element in the same layer. vMix cannot mask across layers."
                                              SelectionChanged="MaskObjectBox_SelectionChanged"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- crop + feather: each collapses to one slider and expands into the four stored edges -->
                        <Border Classes="group" x:Name="CropPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Crop and feather"/>
                                <!-- vertical while both are collapsed, side by side once either expands -->
                                <StackPanel x:Name="CropFeatherStack" Orientation="Vertical" Spacing="4"
                                            VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <Grid x:Name="CropCollapsedGrid" ColumnDefinitions="52,Auto,56">
                                                <TextBlock Grid.Column="0" Classes="lbl" Text="Crop"/>
                                                <Slider Grid.Column="1" x:Name="CropAllSlider" Width="80"
                                                        Minimum="0" Maximum="50" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Column="2" x:Name="CropAllBox"
                                                               FormatString="F0" Minimum="0" Maximum="50" Increment="1"/>
                                            </Grid>
                                            <Grid x:Name="CropExpandedGrid" IsVisible="False"
                                                  ColumnDefinitions="Auto,Auto,52,12,Auto,Auto,52" RowDefinitions="Auto,4,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="X0"/>
                                                <Slider Grid.Row="0" Grid.Column="1" x:Name="CropX0Slider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="0" Grid.Column="2" x:Name="CropX0Box"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                                <TextBlock Grid.Row="0" Grid.Column="4" Classes="lbl" Text="X1"/>
                                                <Slider Grid.Row="0" Grid.Column="5" x:Name="CropX1Slider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="0" Grid.Column="6" x:Name="CropX1Box"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="Y0"/>
                                                <Slider Grid.Row="2" Grid.Column="1" x:Name="CropY0Slider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="2" Grid.Column="2" x:Name="CropY0Box"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                                <TextBlock Grid.Row="2" Grid.Column="4" Classes="lbl" Text="Y1"/>
                                                <Slider Grid.Row="2" Grid.Column="5" x:Name="CropY1Slider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="2" Grid.Column="6" x:Name="CropY1Box"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                            </Grid>
                                            <TextBlock x:Name="CropCaption" Text="Crop" IsVisible="False"
                                                       FontSize="11" Foreground="#7a7a7a" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel x:Name="CropButtonStack" Orientation="Horizontal" Spacing="2"
                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                            <ToggleButton x:Name="CropExpandButton" Classes="rb sm"
                                                          ToolTip.Tip="Expand into the four stored crop edges (X0 / X1 / Y0 / Y1)"
                                                          Click="CropExpandButton_Click">
                                                <Border Background="#e6e6e6" Width="14" Height="14">
                                                    <Border.OpacityMask>
                                                        <ImageBrush Source="avares://GtPlus/Assets/Icons/expand.png" Stretch="Uniform"/>
                                                    </Border.OpacityMask>
                                                </Border>
                                            </ToggleButton>
                                            <Button x:Name="CropResetButton" Classes="rb sm"
                                                    ToolTip.Tip="Reset the crop range"
                                                    Click="CropResetButton_Click">
                                                <Border Background="#e6e6e6" Width="14" Height="14">
                                                    <Border.OpacityMask>
                                                        <ImageBrush Source="avares://GtPlus/Assets/Icons/revert.png" Stretch="Uniform"/>
                                                    </Border.OpacityMask>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border x:Name="CropFeatherSeparator" IsVisible="False"
                                            Width="1" Background="#2e2e2e" VerticalAlignment="Stretch" Margin="8,0"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <Grid x:Name="FeatherCollapsedGrid" ColumnDefinitions="52,Auto,56">
                                                <TextBlock Grid.Column="0" Classes="lbl" Text="Feather"/>
                                                <Slider Grid.Column="1" x:Name="FeatherAllSlider" Width="80"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Column="2" x:Name="FeatherAllBox"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                            </Grid>
                                            <Grid x:Name="FeatherExpandedGrid" IsVisible="False"
                                                  ColumnDefinitions="Auto,Auto,52,12,Auto,Auto,52" RowDefinitions="Auto,4,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="L"/>
                                                <Slider Grid.Row="0" Grid.Column="1" x:Name="FeatherLeftSlider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="0" Grid.Column="2" x:Name="FeatherLeftBox"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                                <TextBlock Grid.Row="0" Grid.Column="4" Classes="lbl" Text="T"/>
                                                <Slider Grid.Row="0" Grid.Column="5" x:Name="FeatherTopSlider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="0" Grid.Column="6" x:Name="FeatherTopBox"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="R"/>
                                                <Slider Grid.Row="2" Grid.Column="1" x:Name="FeatherRightSlider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="2" Grid.Column="2" x:Name="FeatherRightBox"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                                <TextBlock Grid.Row="2" Grid.Column="4" Classes="lbl" Text="B"/>
                                                <Slider Grid.Row="2" Grid.Column="5" x:Name="FeatherBottomSlider" Width="72"
                                                        Minimum="0" Maximum="100" Margin="0,0,4,0"/>
                                                <NumericUpDown Grid.Row="2" Grid.Column="6" x:Name="FeatherBottomBox"
                                                               FormatString="F0" Minimum="0" Maximum="100" Increment="1"/>
                                            </Grid>
                                            <TextBlock x:Name="FeatherCaption" Text="Feather" IsVisible="False"
                                                       FontSize="11" Foreground="#7a7a7a" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel x:Name="FeatherButtonStack" Orientation="Horizontal" Spacing="2"
                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                            <ToggleButton x:Name="FeatherExpandButton" Classes="rb sm"
                                                          ToolTip.Tip="Expand into the four stored feather edges (left / top / right / bottom)"
                                                          Click="FeatherExpandButton_Click">
                                                <Border Background="#e6e6e6" Width="14" Height="14">
                                                    <Border.OpacityMask>
                                                        <ImageBrush Source="avares://GtPlus/Assets/Icons/expand.png" Stretch="Uniform"/>
                                                    </Border.OpacityMask>
                                                </Border>
                                            </ToggleButton>
                                            <Button x:Name="FeatherResetButton" Classes="rb sm"
                                                    ToolTip.Tip="Reset the feather widths"
                                                    Click="FeatherResetButton_Click">
                                                <Border Background="#e6e6e6" Width="14" Height="14">
                                                    <Border.OpacityMask>
                                                        <ImageBrush Source="avares://GtPlus/Assets/Icons/revert.png" Stretch="Uniform"/>
                                                    </Border.OpacityMask>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════ ANIMATIONS ════════ -->
                <ScrollViewer x:Name="AnimationsPage" IsVisible="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="AnimationsHost" Margin="4,0"/>
                </ScrollViewer>

                <!-- ════════ DATA ════════ -->
                <ScrollViewer x:Name="DataPage" IsVisible="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- three-state: indeterminate means the selection disagrees -->
                        <Border Classes="group" x:Name="DataFlagsPanel" IsEnabled="False">
                            <DockPanel>
                                <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Options"/>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <CheckBox x:Name="FlagHiddenCheck" Content="Hidden" IsThreeState="True"
                                              ToolTip.Tip="Hidden from the vMix title editor"
                                              Click="FlagHiddenCheck_Click"/>
                                    <CheckBox x:Name="FlagNoEventsCheck" Content="Disable events" IsThreeState="True"
                                              ToolTip.Tip="Text or image changes do not trigger the DataChangeIn / DataChangeOut storyboards"
                                              Click="FlagNoEventsCheck_Click"/>
                                    <CheckBox x:Name="FlagShowVisibleCheck" Content="Show visible toggle" IsThreeState="True"
                                              ToolTip.Tip="Exposed in the vMix title editor with a visibility toggle"
                                              Click="FlagShowVisibleCheck_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ContentControl x:Name="DataHost"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════ VIEW (GT Plus) ════════ -->
                <ScrollViewer x:Name="ViewPage" IsVisible="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="ViewHost" Margin="4,0"/>
                </ScrollViewer>

            </Panel>
        </Border>
    </DockPanel>
</UserControl>

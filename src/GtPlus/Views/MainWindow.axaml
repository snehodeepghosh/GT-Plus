<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GtPlus.Controls"
        x:Class="GtPlus.Views.MainWindow"
        Title="Optimal GT Designer"
        Width="1280" Height="780"
        MinWidth="640" MinHeight="400"
        Background="#0d0d0d">

    <DockPanel>

        <!-- ribbon: GT's File / Home / Styles / Format / Effects / Animations / Data tabs; the window's own commands are dropped into its slots -->
        <controls:PropertiesPanelControl x:Name="PropertiesPanel"
                                         DockPanel.Dock="Top">

            <controls:PropertiesPanelControl.FileContent>
                <Menu Classes="file">
                    <MenuItem Header="_File" x:Name="FileMenu" />
                </Menu>
            </controls:PropertiesPanelControl.FileContent>

            <controls:PropertiesPanelControl.QuickAccessContent>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="rb row" HorizontalAlignment="Left" ToolTip.Tip="About Optimal GT Designer" Click="About_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="ic s14"
                                  Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 9.1,9 A 3,3 0 0 1 14.9,10 C 14.9,12 12,12.5 12,14 M 12,17.5 L 12,17.6"/>
                            <TextBlock Text="Help"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PropertiesPanelControl.QuickAccessContent>

            <!-- Home, before Font: Undo + Clipboard -->
            <controls:PropertiesPanelControl.HomeStartContent>
                <StackPanel Orientation="Horizontal">
                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Undo"/>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="UndoMenuItem" Classes="rb lg" IsEnabled="False"
                                        ToolTip.Tip="Undo (Ctrl+Z)" Click="Undo_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 9,14 L 4,9 L 9,4 M 4,9 L 14.5,9 A 5.5,5.5 0 0 1 14.5,20 L 11,20"/>
                                        <TextBlock Text="Undo"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RedoMenuItem" Classes="rb lg" IsEnabled="False"
                                        ToolTip.Tip="Redo (Ctrl+Y)" Click="Redo_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 15,14 L 20,9 L 15,4 M 20,9 L 9.5,9 A 5.5,5.5 0 0 0 9.5,20 L 13,20"/>
                                        <TextBlock Text="Redo"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Clipboard"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="PasteMenuItem" Classes="rb lg"
                                        ToolTip.Tip="Paste into the selected layer (Ctrl+V)" Click="Paste_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 9,2 L 15,2 L 15,6 L 9,6 Z M 8,4 L 6,4 A 2,2 0 0 0 4,6 L 4,20 A 2,2 0 0 0 6,22 L 18,22 A 2,2 0 0 0 20,20 L 20,6 A 2,2 0 0 0 18,4 L 16,4"/>
                                        <TextBlock Text="Paste"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="rb row" ToolTip.Tip="Copy (Ctrl+C)" Click="Copy_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14"
                                                  Data="M 10,8 L 18,8 A 2,2 0 0 1 20,10 L 20,18 A 2,2 0 0 1 18,20 L 10,20 A 2,2 0 0 1 8,18 L 8,10 A 2,2 0 0 1 10,8 Z M 4,16 L 4,6 A 2,2 0 0 1 6,4 L 16,4"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DuplicateElementMenuItem" Classes="rb row" IsEnabled="False"
                                            ToolTip.Tip="Duplicate (Ctrl+D)" Click="DuplicateElement_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14"
                                                  Data="M 10,8 L 18,8 A 2,2 0 0 1 20,10 L 20,18 A 2,2 0 0 1 18,20 L 10,20 A 2,2 0 0 1 8,18 L 8,10 A 2,2 0 0 1 10,8 Z M 4,16 L 4,6 A 2,2 0 0 1 6,4 L 16,4 M 14,11 L 14,17 M 11,14 L 17,14"/>
                                            <TextBlock Text="Duplicate"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteElementMenuItem" Classes="rb row" IsEnabled="False"
                                            ToolTip.Tip="Delete (Del)" Click="DeleteElement_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14"
                                                  Data="M 3,6 L 21,6 M 19,6 L 19,20 A 2,2 0 0 1 17,22 L 7,22 A 2,2 0 0 1 5,20 L 5,6 M 8,6 L 8,4 A 2,2 0 0 1 10,2 L 14,2 A 2,2 0 0 1 16,4 L 16,6"/>
                                            <TextBlock Text="Delete"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </controls:PropertiesPanelControl.HomeStartContent>

            <!-- Home, after Align: Arrange (layers + convert) -->
            <controls:PropertiesPanelControl.HomeEndContent>
                <StackPanel Orientation="Horizontal">
                <Border Classes="group">
                    <DockPanel>
                        <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Fonts"/>
                        <Button Classes="rb lg" ToolTip.Tip="Replace fonts across the whole title or the selection" Click="ReplaceFonts_Click">
                            <StackPanel>
                                <Path Classes="ic" Data="M 3,19 L 8,5 L 13,19 M 5,14 L 11,14 M 15,9 L 21,9 M 18,6 L 21,9 L 18,12 M 21,16 L 15,16 M 18,13 L 15,16 L 18,19"/>
                                <TextBlock Text="Replace fonts"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <Border Classes="group">
                    <DockPanel>
                        <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Arrange"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="rb lg" ToolTip.Tip="New layer (Ctrl+Shift+N)" Click="NewLayer_Click">
                                <StackPanel>
                                    <Path Classes="ic" Data="M 12,3 L 21,8 L 12,13 L 3,8 Z M 3,13 L 12,18 L 21,13 M 18,17 L 18,23 M 15,20 L 21,20"/>
                                    <TextBlock Text="New layer"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <Button Classes="rb row" ToolTip.Tip="Duplicate layer (Ctrl+Shift+D)" Click="DuplicateLayer_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Classes="ic s14"
                                              Data="M 12,3 L 21,8 L 12,13 L 3,8 Z M 3,13 L 12,18 L 21,13 M 3,17 L 12,22 L 21,17"/>
                                        <TextBlock Text="Duplicate layer"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteLayerMenuItem" Classes="rb row" ToolTip.Tip="Delete layer" Click="DeleteLayer_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Classes="ic s14"
                                              Data="M 12,3 L 21,8 L 12,13 L 3,8 Z M 3,13 L 12,18 L 21,13 M 15,20 L 21,20"/>
                                        <TextBlock Text="Delete layer"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="rb row" ToolTip.Tip="Replace the selected objects with another kind, keeping position, size and name">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="Text"      Click="ReplaceWithText_Click" />
                                            <MenuItem Header="Rectangle" Click="ReplaceWithRectangle_Click" />
                                            <MenuItem Header="Ellipse"   Click="ReplaceWithEllipse_Click" />
                                            <MenuItem Header="Image..."  Click="ReplaceWithImage_Click" />
                                            <MenuItem Header="Ticker"    Click="ReplaceWithTicker_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Classes="ic s14"
                                              Data="M 16,3 L 20,7 L 16,11 M 20,7 L 4,7 M 8,21 L 4,17 L 8,13 M 4,17 L 20,17"/>
                                        <TextBlock Text="Replace with"/>
                                        <Path Classes="ic s8" Data="M 6,9 L 12,15 L 18,9"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                </StackPanel>
            </controls:PropertiesPanelControl.HomeEndContent>

            <controls:PropertiesPanelControl.AnimationsContent>
                <StackPanel Orientation="Horizontal">
                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Storyboard"/>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="TimelineToggleButton" Classes="rb lg" IsChecked="False"
                                              ToolTip.Tip="Storyboard timeline (Ctrl+T)"
                                              Click="TimelineToggleButton_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 3,6 L 14,6 M 7,12 L 21,12 M 3,18 L 12,18 M 17,3 L 17,9 M 4,9 L 4,15 M 15,15 L 15,21"/>
                                        <TextBlock Text="Timeline"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="PreviewToggleButton" Classes="rb lg" IsChecked="False"
                                              ToolTip.Tip="Preview the storyboard on the canvas. Switch off to show the document at rest so elements can be selected, moved and resized again."
                                              Click="PreviewToggleButton_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 2,12 C 4.5,7 8,5 12,5 C 16,5 19.5,7 22,12 C 19.5,17 16,19 12,19 C 8,19 4.5,17 2,12 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 1 0 12,9 Z"/>
                                        <TextBlock Text="Preview"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Export"/>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="rb lg" ToolTip.Tip="Render a storyboard to an MP4, or a transparent MOV / WebM file"
                                        Click="ExportVideo_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 3,5 L 21,5 L 21,19 L 3,19 Z M 7,5 L 7,19 M 17,5 L 17,19 M 3,9.5 L 7,9.5 M 3,14.5 L 7,14.5 M 17,9.5 L 21,9.5 M 17,14.5 L 21,14.5"/>
                                        <TextBlock Text="Video"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="rb lg" ToolTip.Tip="Export a still at the title's resolution"
                                        Click="ExportPng_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 4,3 L 20,3 A 1,1 0 0 1 21,4 L 21,20 A 1,1 0 0 1 20,21 L 4,21 A 1,1 0 0 1 3,20 L 3,4 A 1,1 0 0 1 4,3 Z M 3,16 L 8,11 L 13,16 M 12,15 L 15,12 L 21,18 M 15.5,7.5 L 15.6,7.5"/>
                                        <TextBlock Text="PNG"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </controls:PropertiesPanelControl.AnimationsContent>

            <controls:PropertiesPanelControl.DataContent>
                <Border Classes="group">
                    <DockPanel>
                        <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Source"/>
                        <Button x:Name="DataVerifierButton" Classes="rb lg"
                                ToolTip.Tip="Check a JSON / XML / CSV data source against this title's elements"
                                Click="DataVerifier_Click">
                            <StackPanel>
                                <Path Classes="ic" Data="M 12,3 C 16.97,3 21,4.34 21,6 C 21,7.66 16.97,9 12,9 C 7.03,9 3,7.66 3,6 C 3,4.34 7.03,3 12,3 Z M 3,6 L 3,18 C 3,19.66 7.03,21 12,21 M 21,6 L 21,12 M 3,12 C 3,13.66 7.03,15 12,15 M 15,19 L 17,21 L 21,17"/>
                                <TextBlock Text="Verify source"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </controls:PropertiesPanelControl.DataContent>

            <controls:PropertiesPanelControl.ViewContent>
                <StackPanel Orientation="Horizontal">
                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Show"/>
                            <ToggleButton x:Name="RulersMenuItem" Classes="rb lg"
                                          ToolTip.Tip="Rulers (Ctrl+R)" Click="ToggleRulers_Click">
                                <StackPanel>
                                    <Path Classes="ic" Data="M 3,8 L 8,3 L 21,16 L 16,21 Z M 7,10 L 9,8 M 10,13 L 12,11 M 13,16 L 15,14"/>
                                    <TextBlock Text="Rulers"/>
                                </StackPanel>
                            </ToggleButton>
                        </DockPanel>
                    </Border>

                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Background"/>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <ToggleButton x:Name="BackgroundGridButton" Classes="rb row"
                                              ToolTip.Tip="Transparency grid behind the title" Click="BackgroundGrid_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Classes="ic s14"
                                              Fill="#a6a6a6"
                                              Data="F0 M 3,3 L 21,3 L 21,21 L 3,21 Z M 3,3 L 12,3 L 12,12 L 3,12 Z M 12,12 L 21,12 L 21,21 L 12,21 Z"/>
                                        <TextBlock Text="Grid"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BackgroundBlackButton" Classes="rb row"
                                              ToolTip.Tip="Solid black, as the title will key over black" Click="BackgroundBlack_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Classes="ic s14" Fill="#000000" Data="M 3,3 L 21,3 L 21,21 L 3,21 Z"/>
                                        <TextBlock Text="Black"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Reference"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="ReferenceShowButton" Classes="rb lg" IsEnabled="False"
                                              ToolTip.Tip="Lay the original design over the title to check it matches. After a PSD import this is Photoshop's own preview of the file. Never saved into the title"
                                              Click="ReferenceShow_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 3,5 L 15,5 L 15,15 L 3,15 Z M 9,9 L 21,9 L 21,19 L 9,19 Z"/>
                                        <TextBlock Text="Reference"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="rb row" ToolTip.Tip="Use an image file as the reference" Click="ReferenceLoad_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14" Data="M 3,5 L 21,5 L 21,19 L 3,19 Z M 3,16 L 9,10 L 14,15 L 17,12 L 21,16"/>
                                            <TextBlock Text="Load image..."/>
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton x:Name="ReferenceDifferenceButton" Classes="rb row" IsEnabled="False"
                                                  ToolTip.Tip="Difference: wherever the title matches the reference the canvas goes black, so mismatches light up"
                                                  Click="ReferenceDifference_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14" Data="M 12,3 A 9,9 0 1 0 12,21 Z M 12,3 A 9,9 0 0 1 12,21"/>
                                            <TextBlock Text="Difference"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Slider x:Name="ReferenceOpacitySlider" Width="74" Minimum="0" Maximum="100" Value="50"
                                                IsEnabled="False" VerticalAlignment="Center"
                                                ToolTip.Tip="Reference opacity" ValueChanged="ReferenceOpacity_Changed"/>
                                        <Button x:Name="ReferenceClearButton" Classes="rb sm" IsEnabled="False"
                                                ToolTip.Tip="Remove the reference image" Click="ReferenceClear_Click">
                                            <TextBlock Text="✕" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Guides"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="ShowGuidesMenuItem" Classes="rb lg" IsChecked="True"
                                              ToolTip.Tip="Show guides (Ctrl+;)" Click="ToggleShowGuides_Click">
                                    <StackPanel>
                                        <Path Classes="ic" Data="M 9,3 L 9,21 M 3,15 L 21,15 M 3,3 L 21,3 L 21,21 L 3,21 Z"/>
                                        <TextBlock Text="Guides"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Grid ColumnDefinitions="Auto,4,Auto" RowDefinitions="Auto,4,Auto" VerticalAlignment="Center">
                                    <Button Grid.Row="0" Grid.Column="0" Classes="rb row" Click="NewHorizontalGuide_Click"
                                            ToolTip.Tip="New horizontal guide">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14" Data="M 3,12 L 21,12"/>
                                            <TextBlock Text="Horizontal"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="0" Classes="rb row" Click="NewVerticalGuide_Click"
                                            ToolTip.Tip="New vertical guide">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14" Data="M 12,3 L 12,21"/>
                                            <TextBlock Text="Vertical"/>
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton Grid.Row="0" Grid.Column="2" x:Name="LockGuidesMenuItem" Classes="rb row"
                                                  ToolTip.Tip="Lock guides (Ctrl+Alt+;)" Click="ToggleLockGuides_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14"
                                                  Data="M 5,11 L 19,11 L 19,21 L 5,21 Z M 8,11 L 8,7 A 4,4 0 0 1 16,7 L 16,11"/>
                                            <TextBlock Text="Lock"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Grid.Row="2" Grid.Column="2" x:Name="ClearGuidesMenuItem" Classes="rb row"
                                            ToolTip.Tip="Remove every guide" Click="ClearGuides_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Classes="ic s14" Data="M 6,6 L 18,18 M 18,6 L 6,18"/>
                                            <TextBlock Text="Clear"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Snap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton x:Name="SnapMenuItem" Classes="rb lg" IsChecked="True"
                                              ToolTip.Tip="Snap (Ctrl+Shift+;) - pull elements onto guides, other elements and the canvas"
                                              Click="ToggleSnap_Click">
                                    <StackPanel>
                                        <Border Background="#e6e6e6" Width="24" Height="24" Margin="0,4,0,6">
                                            <Border.OpacityMask>
                                                <ImageBrush Source="avares://GtPlus/Assets/Icons/magnet.png" Stretch="Uniform"/>
                                            </Border.OpacityMask>
                                        </Border>
                                        <TextBlock Text="Snap"/>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <CheckBox x:Name="SnapGuidesMenuItem"   Content="Guides"          IsChecked="True" Click="SnapTarget_Click"/>
                                    <CheckBox x:Name="SnapElementsMenuItem" Content="Elements"        IsChecked="True" Click="SnapTarget_Click"/>
                                    <CheckBox x:Name="SnapCanvasMenuItem"   Content="Document bounds" IsChecked="True" Click="SnapTarget_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="group">
                        <DockPanel>
                            <TextBlock Classes="caption" DockPanel.Dock="Bottom" Text="Settings"/>
                            <Button Classes="rb lg" ToolTip.Tip="Preferences" Click="Preferences_Click">
                                <StackPanel>
                                    <Path Classes="ic" Data="M 4,21 L 4,14 M 4,10 L 4,3 M 12,21 L 12,12 M 12,8 L 12,3 M 20,21 L 20,16 M 20,12 L 20,3 M 1,14 L 7,14 M 9,8 L 15,8 M 17,16 L 23,16"/>
                                    <TextBlock Text="Preferences"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </controls:PropertiesPanelControl.ViewContent>
        </controls:PropertiesPanelControl>

        <!-- status bar: status (left) + canvas toggles and zoom (right) -->
        <Border DockPanel.Dock="Bottom"
                Background="#141414"
                Padding="8,0"
                Height="32"
                ClipToBounds="True"
                BorderThickness="0,1,0,0"
                BorderBrush="#2e2e2e">
            <Grid ColumnDefinitions="*,Auto">

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="No file open - File › Open to load a .gtzip"
                           Foreground="#a6a6a6"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="CursorPosLabel"
                               Text=""
                               MinWidth="120"
                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                               FontSize="11"
                               Foreground="#7a7a7a"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="0,0,8,0" />

                    <ToggleButton x:Name="SnapToggleButton"
                                  Classes="flat"
                                  IsChecked="True"
                                  ToolTip.Tip="Snap (Ctrl+Shift+;) - pull elements onto guides, other elements and the canvas"
                                  Click="SnapToggleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#a6a6a6" Width="12" Height="12" VerticalAlignment="Center">
                                <Border.OpacityMask>
                                    <ImageBrush Source="avares://GtPlus/Assets/Icons/magnet.png" Stretch="Uniform"/>
                                </Border.OpacityMask>
                            </Border>
                            <TextBlock Text="Snap" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="PixelGridLockButton"
                                  Classes="flat"
                                  IsChecked="False"
                                  ToolTip.Tip="Pixel grid lock - snap moves and resizes to whole pixels"
                                  Click="PixelGridLockButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Fill="#a6a6a6" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"
                                  Data="M 0,0 L 4,0 L 4,4 L 8,4 L 8,0 L 12,0 L 12,12 L 8,12 L 8,8 L 4,8 L 4,12 L 0,12 Z" />
                            <TextBlock Text="Pixel grid" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Height="14" Background="#2e2e2e" Margin="4,0" />

                    <Button x:Name="FitButton"
                            Classes="flat"
                            Content="Fit"
                            Click="Fit_Click"
                            ToolTip.Tip="Fit to window" />

                    <Slider x:Name="ZoomSlider"
                            Minimum="10" Maximum="400" Value="100"
                            Width="140"
                            Height="32"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="False"
                            ValueChanged="ZoomSlider_ValueChanged" />

                    <TextBlock x:Name="ZoomLabel"
                               Text="100%"
                               Width="40"
                               FontSize="11"
                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                               Foreground="#a6a6a6"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- storyboard timeline, collapsed until toggled (Ctrl+T); declared after the status bar so it docks above it -->
        <controls:TimelinePanelControl x:Name="TimelinePanel"
                                       DockPanel.Dock="Bottom"
                                       Height="196"
                                       IsVisible="False" />

        <!-- left toolbar -->
        <Border DockPanel.Dock="Left"
                Background="#141414"
                BorderBrush="#2e2e2e"
                BorderThickness="0,0,1,0"
                Padding="4,8">
            <StackPanel Orientation="Vertical" Spacing="4">

                <ToggleButton x:Name="SelectToolButton"
                              IsVisible="False"
                              IsChecked="False"
                              ToolTip.Tip="Select (S) - Click to select, drag to move, Ctrl+drag to box-select"
                              Classes="tool"
                              Click="SelectToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 2,1 L 2,12 L 5,9 L 7,14 L 9,13 L 7,8 L 11,8 Z" />
                    </Panel>
                </ToggleButton>

                <ToggleButton x:Name="EditToolButton"
                              IsChecked="True"
                              ToolTip.Tip="Move (V) - Click to select, drag to move, drag a handle to resize (Alt = from the centre, Shift = keep proportions), Shift+click to add to the selection, Ctrl+drag to box-select"
                              Classes="tool"
                              Click="EditToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 8,0 L 6,3 L 7,3 L 7,7 L 3,7 L 3,6 L 0,8 L 3,10 L 3,9 L 7,9 L 7,13 L 6,13 L 8,16 L 10,13 L 9,13 L 9,9 L 13,9 L 13,10 L 16,8 L 13,6 L 13,7 L 9,7 L 9,3 L 10,3 Z" />
                    </Panel>
                </ToggleButton>

                <Border Height="1" Background="#2e2e2e" Margin="4,4" />

                <ToggleButton x:Name="TextBoxToolButton"
                              IsChecked="False"
                              ToolTip.Tip="Text Box (T) - Draw a text box"
                              Classes="tool"
                              Click="TextBoxToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 0,0 L 16,0 L 16,4 L 10,4 L 10,16 L 6,16 L 6,4 L 0,4 Z" />
                    </Panel>
                </ToggleButton>

                <ToggleButton x:Name="RectangleToolButton"
                              IsChecked="False"
                              ToolTip.Tip="Rectangle (R) - Draw a rectangle"
                              Classes="tool"
                              Click="RectangleToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 0,2 L 16,2 L 16,14 L 0,14 Z M 2,4 L 14,4 L 14,12 L 2,12 Z" />
                    </Panel>
                </ToggleButton>

                <ToggleButton x:Name="TickerToolButton"
                              IsChecked="False"
                              ToolTip.Tip="Ticker (K) - Draw a scrolling ticker"
                              Classes="tool"
                              Click="TickerToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 0,3 L 16,3 L 16,13 L 0,13 Z M 1,4 L 1,12 L 15,12 L 15,4 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 3,6 L 7,6 L 7,10 L 3,10 Z M 9,6 L 13,6 L 13,10 L 9,10 Z" />
                    </Panel>
                </ToggleButton>

                <Button x:Name="ImageToolButton"
                        ToolTip.Tip="Image (I) - Insert an image file"
                        Classes="tool"
                        Click="ImageToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 0,1 L 16,1 L 16,15 L 0,15 Z M 1,2 L 1,14 L 15,14 L 15,2 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 2,12 L 5,8 L 8,11 L 10,9 L 14,12 Z" />
                    </Panel>
                </Button>

                <!-- image sequence: many frames behind one resource, so it gets its own insert with a source picker -->
                <Button x:Name="ImageSequenceToolButton"
                        ToolTip.Tip="Image Sequence (Shift+I files, Ctrl+Shift+I folder) - Insert numbered frames as one sequence; a folder can also be dropped on the canvas"
                        Classes="tool">
                    <Button.Flyout>
                        <MenuFlyout Placement="Right">
                            <MenuItem Header="From _Files..."  Click="ImageSequenceFromFiles_Click" />
                            <MenuItem Header="From F_older..." Click="ImageSequenceFromFolder_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 4,0 L 16,0 L 16,10 L 14,10 L 14,2 L 4,2 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 2,3 L 13,3 L 13,12 L 11,12 L 11,5 L 2,5 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 0,6 L 10,6 L 10,16 L 0,16 Z M 1,7 L 1,15 L 9,15 L 9,7 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 3,9 L 7,11 L 3,13 Z" />
                    </Panel>
                </Button>

                <Border Height="1" Background="#2e2e2e" Margin="4,4" />

                <ToggleButton x:Name="WebToolButton"
                              IsChecked="False"
                              ToolTip.Tip="Web Page (W) - Click for a page filling the canvas, or drag a box"
                              Classes="tool"
                              Click="WebToolButton_Click">
                    <Panel Width="16" Height="16">
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 8,0 A 8,8 0 1 0 8,16 A 8,8 0 1 0 8,0 Z M 8,1.5 A 6.5,6.5 0 1 1 8,14.5 A 6.5,6.5 0 1 1 8,1.5 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="M 1.5,7.5 L 14.5,7.5 L 14.5,8.5 L 1.5,8.5 Z" />
                        <Path Fill="#d0d0d0" Stretch="None"
                              Data="F1 M 8,0.5 A 3.4,7.5 0 1 0 8,15.5 A 3.4,7.5 0 1 0 8,0.5 Z M 8,1.5 A 2.4,6.5 0 1 1 8,14.5 A 2.4,6.5 0 1 1 8,1.5 Z" />
                    </Panel>
                </ToggleButton>

            </StackPanel>
        </Border>

        <!-- right panel: tab strip + layers/history + optional debug -->
        <Grid DockPanel.Dock="Right" Width="248" RowDefinitions="Auto,*,Auto">

            <!-- tab strip -->
            <Border Grid.Row="0"
                    Background="#141414"
                    BorderBrush="#2e2e2e"
                    BorderThickness="1,0,0,1">
                <Grid ColumnDefinitions="*,*">
                    <ToggleButton x:Name="LayersTabButton"
                                  Grid.Column="0"
                                  IsChecked="True"
                                  Content="Layers"
                                  Classes="tab"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Click="LayersTab_Click" />
                    <ToggleButton x:Name="HistoryTabButton"
                                  Grid.Column="1"
                                  IsChecked="False"
                                  Content="History"
                                  Classes="tab"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Click="HistoryTab_Click" />
                </Grid>
            </Border>

            <!-- panel area, only one visible at a time -->
            <Panel Grid.Row="1">
                <controls:LayersPanelControl x:Name="LayersPanel" />
                <controls:HistoryPanelControl x:Name="HistoryPanel" IsVisible="False" />
            </Panel>

            <!-- debug info panel, hidden by default, toggled in Preferences -->
            <Border x:Name="DebugPanel"
                    Grid.Row="2"
                    IsVisible="False"
                    Background="#0a0a0a"
                    BorderBrush="#333333"
                    BorderThickness="1,1,0,0">
                <DockPanel MaxHeight="260">
                    <Border DockPanel.Dock="Top"
                            Background="#1a1a1a"
                            Padding="10,5"
                            BorderBrush="#333333"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Debug"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#ff6060" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DebugText"
                                   Padding="10,8"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="11"
                                   Foreground="#cccccc"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

        <!-- canvas area: rulers along the top/left edges, dark surround, scrollbars when zoomed in -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">

            <!-- origin box: drag onto the canvas to move 0,0, double-click to reset -->
            <Border x:Name="RulerCorner"
                    Grid.Row="0" Grid.Column="0"
                    Width="18" Height="18"
                    IsVisible="False"
                    Background="#141414"
                    BorderBrush="#2e2e2e"
                    BorderThickness="0,0,1,1"
                    ToolTip.Tip="Drag to set the ruler origin - double-click to reset"
                    PointerPressed="RulerCorner_PointerPressed"
                    PointerMoved="RulerCorner_PointerMoved"
                    PointerReleased="RulerCorner_PointerReleased"
                    DoubleTapped="RulerCorner_DoubleTapped" />

            <controls:RulerControl x:Name="TopRuler"
                                   Grid.Row="0" Grid.Column="1"
                                   Height="18"
                                   IsVisible="False"
                                   Orientation="Horizontal" />

            <controls:RulerControl x:Name="LeftRuler"
                                   Grid.Row="1" Grid.Column="0"
                                   Width="18"
                                   IsVisible="False"
                                   Orientation="Vertical" />

            <ScrollViewer x:Name="CanvasScrollViewer"
                          Grid.Row="1" Grid.Column="1"
                          Background="#0d0d0d"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AllowAutoHide="False">
                <controls:GtCanvasControl x:Name="GtCanvas"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="24" />
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>
